# Environment Configuration for Nectar Empire
# Copy this file to .env and customize for your deployment

################################################################################
# EXECUTION ENVIRONMENT
################################################################################

# Deployment environment: production, staging, development
NECTAR_ENV=production

# Base directory for external dependencies (powers, imperial logic)
# Leave empty to use ./dependencies or NECTAR_DEPS_DIR environment variable
NECTAR_DEPS_DIR=./dependencies

# Directory for persistent state files
NECTAR_STATE_DIR=./state

# Directory for logs and reports
NECTAR_LOG_DIR=./logs

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
NECTAR_LOG_LEVEL=INFO

################################################################################
# PHASE & STATUS CONTROL
################################################################################

# Current phase version (e.g., 13.0, 13.1)
NECTAR_PHASE=13.0

# Empire status: VIVOS (alive/active), HIBERNATION, MAINTENANCE
NECTAR_STATUS=VIVOS

# Environment region/cluster identifier
NECTAR_REGION=IMPERIAL_MESH_GLOBAL

################################################################################
# MESH NODE API ENDPOINTS
# Cross-repository synchronization endpoints
################################################################################

# Nectar_Wealth: Financial distillation and yield optimization
NECTAR_WEALTH_URL=http://localhost:8001/api/sync
NECTAR_WEALTH_SYNC_PROTOCOL=lattice_v13
NECTAR_WEALTH_TIMEOUT=30
NECTAR_WEALTH_RETRY_COUNT=3

# Nectar_Dev: Technical sovereignty and code automation
NECTAR_DEV_URL=http://localhost:8002/api/sync
NECTAR_DEV_SYNC_PROTOCOL=lattice_v13
NECTAR_DEV_TIMEOUT=30
NECTAR_DEV_RETRY_COUNT=3

# Nectar_Health: Bio-performance scaling and wellness
NECTAR_HEALTH_URL=http://localhost:8003/api/sync
NECTAR_HEALTH_SYNC_PROTOCOL=lattice_v13
NECTAR_HEALTH_TIMEOUT=30
NECTAR_HEALTH_RETRY_COUNT=3

# Nectar_Pets: Pet market and loyalty intelligence
NECTAR_PETS_URL=http://localhost:8004/api/sync
NECTAR_PETS_SYNC_PROTOCOL=lattice_v13
NECTAR_PETS_TIMEOUT=30
NECTAR_PETS_RETRY_COUNT=3

################################################################################
# EXECUTION TUNING
################################################################################

# Maximum concurrent subprocess execution (semaphore limit)
NECTAR_MAX_CONCURRENT_TASKS=4

# Default timeout per task in seconds
NECTAR_DEFAULT_TASK_TIMEOUT=60

# Default timeout per milestone in seconds
NECTAR_DEFAULT_MILESTONE_TIMEOUT=120

# Global hard timeout in seconds (1 hour)
NECTAR_GLOBAL_TIMEOUT=3600

# Fail fast: halt on any failure (true/false)
NECTAR_FAIL_FAST=false

# Retry strategy: exponential_backoff, linear, none
NECTAR_RETRY_STRATEGY=exponential_backoff

# Maximum retry attempts per task
NECTAR_MAX_RETRIES=2

# Initial retry delay in milliseconds
NECTAR_RETRY_DELAY_MS=100

# Enable parallel milestone execution (true/false)
NECTAR_PARALLEL_MILESTONES=true

################################################################################
# LOGGING & OBSERVABILITY
################################################################################

# Log format: json, text
NECTAR_LOG_FORMAT=json

# Capture subprocess stdout (true/false)
NECTAR_CAPTURE_STDOUT=true

# Capture subprocess stderr (true/false)
NECTAR_CAPTURE_STDERR=true

# Maximum log file size in MB before rotation
NECTAR_MAX_LOG_SIZE_MB=500

################################################################################
# RESOURCE CONSTRAINTS
################################################################################

# Process memory limit in MB
NECTAR_PROCESS_MEMORY_LIMIT_MB=1024

# Subprocess memory limit in MB
NECTAR_SUBPROCESS_MEMORY_LIMIT_MB=512

################################################################################
# PERFORMANCE METRICS
################################################################################

# Target yield metric (0.0 - 1.0)
NECTAR_YIELD_METRIC=0.999999

# Operating frequency in Hz
NECTAR_FREQUENCY_HZ=432.0

# Zero-latency target in milliseconds
NECTAR_ZERO_LATENCY_TARGET_MS=0.1

################################################################################
# DEPLOYMENT IDENTIFIERS
################################################################################

# Unique deployment ID (auto-generated if not set)
NECTAR_DEPLOYMENT_ID=

# Version identifier for tracking releases
NECTAR_VERSION=13.0

################################################################################
# OPTIONAL: ADVANCED CONFIGURATION
################################################################################

# Enable debug mode (verbose logging, no subprocess stdout suppression)
NECTAR_DEBUG=false

# Enable profiling (timing and memory tracking)
NECTAR_PROFILE=false

# Enable dry-run mode (do not execute subprocesses, only plan)
NECTAR_DRY_RUN=false

# Path to manifest.yml (usually config/manifest.yml)
NECTAR_MANIFEST_PATH=config/manifest.yml
